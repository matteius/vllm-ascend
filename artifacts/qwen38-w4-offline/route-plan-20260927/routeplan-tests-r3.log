            ascend_expert_quantization=dict(metadata, backend="cube_310_routed"),
        )
        layer = W4SparseMoE(config=cfg, dtype_policy=Qwen4ExpDtypePolicy()).npu()
        cfg.ascend_expert_quantization = dict(metadata, backend="cube_310_tiled")
